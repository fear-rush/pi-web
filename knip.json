{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,not-found}.tsx",
    "app/**/route.ts",
    "instrumentation.ts",
    "instrumentation-node.ts",
    "proxy.ts",
    "bin/pi-web.js",
    "lib/session/session-list-scanner.bench.mjs",
    "*.config.{ts,mjs}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.ts",
    "lib/**/*.{ts,mjs}",
    "bin/*.js",
    "public/*.js",
    "*.ts"
  ],
  "ignore": [],
  "ignoreDependencies": [
    "@earendil-works/pi-codemode",
    "@earendil-works/pi-mcp",
    "@earendil-works/pi-telemetry",
    "postcss",
    "tailwindcss",
    "@tailwindcss/postcss"
  ]
}
